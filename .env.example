# ============================================================
# Liangyi 工作流引擎 · 环境变量模板
# ============================================================
# 用法：复制本文件为 .env，填入真实 key。.env 已被 .gitignore 挡住，不会进仓库。
#
#   cp .env.example .env
#
# 方法论硬规则：只用维度 A 可判定的模型。
# 阿里 Qwen / 字节豆包 / MiniMax 因厂商未公开后训练目标且无公开规范文本，
# 属"维度 A 未公开"档，不进入本项目的任何窗口——所以这里没有它们的位置。
# ============================================================

# OpenRouter —— 只用于调用 Claude 与 GPT
# 承担窗口：执笔者 / P0 精炼 / P1 专家A / P2A 投资人批判 / P2C 知情复审 / 评分裁判一
# 主力模型 gpt-5.6-luna（A2·B1），对照组 claude-haiku-4.5（A1·B1）
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 官方 —— A3·B3
# 承担窗口：P1 专家B / P2D 拆台（拆台必须是 A3 任务优先档，硬规则）
# 旗舰模型 deepseek-v4-pro
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 月之暗面 Kimi 官方 —— A3·B3
# 承担窗口：P2B 单盲复审（零上下文，底线规则）
# 旗舰模型 kimi-k3
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 GLM 官方 —— A3·B2
# 承担窗口：评分裁判二（与裁判一坐标不同，且都未参与生产）
# 旗舰模型 glm-5.3
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
