# ============================================================
# Liangyi 工作流引擎 · 环境变量模板
# ============================================================
# 用法：复制本文件为 .env，填入真实 key。.env 已被 .gitignore 挡住，不会进仓库。
#
#   cp .env.example .env
#
# 方法论硬规则：只用维度 A 可判定的模型。
# 阿里 Qwen / 字节豆包 / MiniMax 因厂商未公开后训练目标且无公开规范文本，
# 属"维度 A 未公开"档，不进入本项目的任何窗口——所以这里没有它们的位置。
# ============================================================

# OpenRouter —— 只用于调用 Claude 与 GPT
# 承担窗口：执笔者 / P0 精炼 / P1.0 角色生成 / P1 专家A / P2A 投资人批判 / P2C 知情复审 / 决策点摘要
# 正式档 primary 的 anchor 是 claude-sonnet-5（A1·B1）；在线 demo 档的 anchor 是 gpt-5.6-luna（A2·B1）
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 官方 —— A3·B3
# 承担窗口：P1 专家B / P2D 拆台（拆台必须是 A3 任务优先档，硬规则）/ 条件触发检测器（影子模式）
# 正式档 deepseek-v4-pro；在线 demo 档与检测器用 deepseek-v4-flash
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 月之暗面 Kimi 官方 —— A3·B3
# 正式档与在线 demo 档都不用它；只在 debug / smoke / contrast_a2 这些调试档里当单盲位
# 不填也能跑正式档和线上入口
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 GLM 官方 —— A3·B2
# 承担窗口：P2B 单盲复审（零上下文，底线规则）
# 正式档 glm-5.3；在线 demo 档 glm-4-flash
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# ---- 在线入口（web/）----
# 访客每 IP 每天限跑 3 条链；带这个令牌的请求不受限。随便生成一串长随机字符串。
LIANGYI_OWNER_TOKEN=
LIANGYI_DAILY_LIMIT=3
# 跨实例计数用的 Upstash Redis REST 地址与令牌。Vercel 装 Upstash 后自动注入
#（也认 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN），本地跑不用填——没配时退回单进程内存计数。
KV_REST_API_URL=
KV_REST_API_TOKEN=
